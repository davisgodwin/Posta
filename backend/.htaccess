php_value upload_max_filesize 100M
php_value post_max_size 110M
php_value memory_limit 256M

# backend/.htaccess
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, ngrok-skip-browser-warning"
</IfModule>

# Stop Apache from returning 405 on POST methods
<Limit GET POST OPTIONS PUT DELETE>
    Allow from all
</Limit>

# Turn off automatic directory slash redirects that break POST requests
DirectorySlash Off
RewriteEngine Off